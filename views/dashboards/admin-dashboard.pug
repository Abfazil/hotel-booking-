extends ../layout

block content
  section.dashboard
    .dashboard__inner
      .dashboard__header
        h1.dashboard__title Admin Dashboard
        p.dashboard__subtitle Organized control center for hotels, bookings, disputes, cancellations, and customers.
        if flash
          p(class=`auth__message auth__message--${flash.type === 'success' ? 'success' : 'error'}`)= flash.message
        .dashboard__actions
          button.btn--outline(type="button" data-expand-all) Expand all
          button.btn--outline(type="button" data-collapse-all) Collapse all

      .dashboard__card(data-collapsible-card)
        h2.dashboard__card-title Platform totals
        .dashboard__card-body
          p.dashboard__text Standard overview of key platform metrics and system health.
          .dashboard__stats
            .dashboard__stat-card
              p.dashboard__stat-label Total users
              p.dashboard__stat-value= stats.totalUsers
            .dashboard__stat-card
              p.dashboard__stat-label Total bookings
              p.dashboard__stat-value= stats.totalBookings
            .dashboard__stat-card
              p.dashboard__stat-label Total disputes
              p.dashboard__stat-value= stats.totalDisputes

      .dashboard__card(data-collapsible-card)
        h2.dashboard__card-title Hotel Management
        .dashboard__card-body
          p.dashboard__text Create, update, and remove hotels from one section.

      .dashboard__grid
        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Add a new hotel
          .dashboard__card-body
            p.dashboard__text Add hotel details, rooms, and image URLs. Changes appear instantly across the site.
            form.dashboard__hotel-form(action="/admin/hotels" method="POST")
              .dashboard__form-grid
                .dashboard__field
                  label.dashboard__label(for="name") Hotel name
                  input.dashboard__input#name(type="text" name="name" required)
                .dashboard__field
                  label.dashboard__label(for="city") City
                  input.dashboard__input#city(type="text" name="city" required)
                .dashboard__field
                  label.dashboard__label(for="country") Country
                  input.dashboard__input#country(type="text" name="country" required)
                .dashboard__field
                  label.dashboard__label(for="rating") Rating (1-5)
                  input.dashboard__input#rating(type="number" step="0.1" min="1" max="5" name="rating" required)
              .dashboard__field
                label.dashboard__label(for="address") Address
                input.dashboard__input#address(type="text" name="address" required)
              .dashboard__field
                label.dashboard__label(for="rooms") Rooms (one line each: Room Type|Price|Capacity)
                textarea.dashboard__textarea#rooms(name="rooms" rows="4" required placeholder="Single|120|1&#10;Double|180|2&#10;Suite|320|4")
              .dashboard__field
                label.dashboard__label(for="images") Pictures (one image URL per line)
                textarea.dashboard__textarea#images(name="images" rows="3" placeholder="/images/gallery_01.jpg&#10;https://example.com/hotel/front.jpg")
              .dashboard__actions
                button.btn--primary(type="submit") Add hotel

        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Manage hotels
          .dashboard__card-body
            if managedHotels && managedHotels.length
              ul.dashboard__list
                each hotel in managedHotels
                  li.dashboard__list-item
                    .dashboard__item-main
                      form(action=`/admin/hotels/${hotel.id}/update` method="POST")
                        .dashboard__field
                          label.dashboard__label Hotel name
                          input.dashboard__input(type="text" name="name" value=hotel.name required)
                        .dashboard__field
                          label.dashboard__label City
                          input.dashboard__input(type="text" name="city" value=hotel.city required)
                        .dashboard__field
                          label.dashboard__label Country
                          input.dashboard__input(type="text" name="country" value=hotel.country required)
                        .dashboard__field
                          label.dashboard__label Address
                          input.dashboard__input(type="text" name="address" value=hotel.address required)
                        .dashboard__field
                          label.dashboard__label Rating
                          input.dashboard__input(type="number" step="0.1" min="1" max="5" name="rating" value=hotel.rating required)
                        span #{hotel.roomsCount} room(s)
                        if hotel.image
                          span
                            a(href=hotel.image target="_blank" rel="noreferrer") View picture
                        if rowFlash && rowFlash.section === 'hotel' && Number(rowFlash.id) === Number(hotel.id)
                          p(class=`auth__message auth__message--${rowFlash.type === 'success' ? 'success' : 'error'}`)= rowFlash.message
                        .dashboard__actions
                          button.btn--primary(type="submit") Save hotel
                    form(action=`/admin/hotels/${hotel.id}/delete` method="POST" onsubmit="return confirm('Delete this hotel? This action cannot be undone.')")
                      button.btn--outline(type="submit") Remove
            else
              p.dashboard__empty No hotels found.

      .dashboard__card(data-collapsible-card)
        h2.dashboard__card-title Request Management
        .dashboard__card-body
          p.dashboard__text Review all owner and cancellation requests in one workflow.

      .dashboard__grid
        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Hotel owner approval requests
          .dashboard__card-body
            if pendingOwnerRequests && pendingOwnerRequests.length
              ul.dashboard__list
                each request in pendingOwnerRequests
                  li.dashboard__list-item
                    .dashboard__item-main
                      strong #{request.userName} (#{request.email})
                      span Hotel: #{request.hotelName}
                      span #{request.city}, #{request.country} - #{request.address}
                      span Requested rating: #{Number.isFinite(request.rating) ? request.rating.toFixed(1) : 'N/A'}
                      span Requested at: #{request.createdAt}
                    .dashboard__actions
                      form(action=`/admin/owner-requests/${request.requestId}/approve` method="POST")
                        button.btn--primary(type="submit") Approve
                      form(action=`/admin/owner-requests/${request.requestId}/reject` method="POST")
                        input.dashboard__input(type="text" name="reviewNotes" placeholder="Reason (optional)")
                        button.btn--outline(type="submit") Reject
            else
              p.dashboard__empty No pending owner approval requests.

      .dashboard__card(data-collapsible-card)
        h2.dashboard__card-title Booking And Dispute Monitoring
        .dashboard__card-body
          p.dashboard__text Track booking and dispute statuses, then open details by status.

      .dashboard__grid
        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Cancellation status breakdown
          .dashboard__card-body
            if cancellationStatusSummary && cancellationStatusSummary.length
              ul.dashboard__list
                each item in cancellationStatusSummary
                  li.dashboard__list-item
                    .dashboard__item-main
                      strong= item.status
                    span.dashboard__badge= item.total
            else
              p.dashboard__empty No cancellation request data found.

        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Booking status breakdown
          .dashboard__card-body
            if bookingStatusSummary && bookingStatusSummary.length
              ul.dashboard__list
                each item in bookingStatusSummary
                  li.dashboard__list-item
                    .dashboard__item-main
                      strong
                        a(href=`/admin?bookingStatus=${item.encodedStatus}`)= item.status
                    span.dashboard__badge
                      a(href=`/admin?bookingStatus=${item.encodedStatus}`)= item.total
            else
              p.dashboard__empty No booking status data found.

        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Dispute status breakdown
          .dashboard__card-body
            if disputeStatusSummary && disputeStatusSummary.length
              ul.dashboard__list
                each item in disputeStatusSummary
                  li.dashboard__list-item
                    .dashboard__item-main
                      strong
                        a(href=`/admin?disputeStatus=${item.encodedStatus}`)= item.status
                    span.dashboard__badge
                      a(href=`/admin?disputeStatus=${item.encodedStatus}`)= item.total
            else
              p.dashboard__empty No dispute status data found.

      if selectedBookingStatus
        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Booking details: #{selectedBookingStatus}
          .dashboard__card-body
            p
              a(href="/admin") Clear filter
            if filteredBookings && filteredBookings.length
              ul.dashboard__list
                each booking in filteredBookings
                  li.dashboard__list-item
                    .dashboard__item-main
                      strong Booking ##{booking.id} - #{booking.hotelName || 'Hotel'}
                      span Customer: #{booking.customerName || 'N/A'}
                      span #{booking.checkIn} to #{booking.checkOut}
                    span.dashboard__badge= booking.status
            else
              p.dashboard__empty No bookings found for this status.

      if selectedDisputeStatus
        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Dispute details: #{selectedDisputeStatus}
          .dashboard__card-body
            p
              a(href="/admin") Clear filter
            if filteredDisputes && filteredDisputes.length
              ul.dashboard__list
                each dispute in filteredDisputes
                  li.dashboard__list-item
                    .dashboard__item-main
                      strong Dispute ##{dispute.id} (Booking ##{dispute.bookingId})
                      span #{dispute.issue}
                    span.dashboard__badge= dispute.status
            else
              p.dashboard__empty No disputes found for this status.

      .dashboard__grid
        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Recent users
          .dashboard__card-body
            if recentUsers && recentUsers.length
              ul.dashboard__list
                each user in recentUsers
                  li.dashboard__list-item
                    .dashboard__item-main
                      strong #{user.name}
                      span #{user.email}
                    span.dashboard__badge= user.role
            else
              p.dashboard__empty No users found.

        .dashboard__card(data-collapsible-card)
          h2.dashboard__card-title Recent bookings
          .dashboard__card-body
            if recentBookings && recentBookings.length
              ul.dashboard__list
                each booking in recentBookings
                  li.dashboard__list-item
                    .dashboard__item-main
                      strong Booking ##{booking.id} - #{booking.hotelName || 'Hotel'}
                      span Customer: #{booking.customerName || 'N/A'}
                      span #{booking.createdAt}
                      form(action=`/admin/bookings/${booking.id}/update` method="POST")
                        .dashboard__field
                          label.dashboard__label Booking status
                          select.dashboard__input(name="bookingStatus")
                            option(value="Pending" selected=String(booking.status || '').toLowerCase() === 'pending') Pending
                            option(value="Confirmed" selected=String(booking.status || '').toLowerCase() === 'confirmed') Confirmed
                            option(value="Cancelled" selected=String(booking.status || '').toLowerCase() === 'cancelled') Cancelled
                        .dashboard__actions
                          button.btn--primary(type="submit") Save booking
                      if rowFlash && rowFlash.section === 'booking' && Number(rowFlash.id) === Number(booking.id)
                        p(class=`auth__message auth__message--${rowFlash.type === 'success' ? 'success' : 'error'}`)= rowFlash.message
                    .dashboard__actions
                      span.dashboard__badge= booking.status || 'Pending'
                      form(action=`/admin/bookings/${booking.id}/delete` method="POST" onsubmit="return confirm('Delete this booking?')")
                        button.btn--outline(type="submit") Delete
            else
              p.dashboard__empty No bookings found.

      .dashboard__card(data-collapsible-card)
        h2.dashboard__card-title Recent disputes
        .dashboard__card-body
          if recentDisputes && recentDisputes.length
            ul.dashboard__list
              each dispute in recentDisputes
                li.dashboard__list-item
                  .dashboard__item-main
                    strong Dispute ##{dispute.id} (Booking ##{dispute.bookingId}, Customer ##{dispute.userId})
                    form(action=`/admin/disputes/${dispute.id}/update` method="POST")
                      .dashboard__field
                        label.dashboard__label Issue
                        input.dashboard__input(type="text" name="issue" value=dispute.issue required)
                      .dashboard__field
                        label.dashboard__label Status
                        select.dashboard__input(name="disputeStatus")
                          option(value="pending" selected=String(dispute.status || '').toLowerCase() !== 'resolved') Pending
                          option(value="resolved" selected=String(dispute.status || '').toLowerCase() === 'resolved') Resolved
                      .dashboard__actions
                        button.btn--primary(type="submit") Save dispute
                    if rowFlash && rowFlash.section === 'dispute' && Number(rowFlash.id) === Number(dispute.id)
                      p(class=`auth__message auth__message--${rowFlash.type === 'success' ? 'success' : 'error'}`)= rowFlash.message
                    form(action=`/admin/disputes/${dispute.id}/delete` method="POST" onsubmit="return confirm('Delete this dispute?')")
                      button.btn--outline(type="submit") Delete dispute
          else
            p.dashboard__empty No disputes found.

      .dashboard__card(data-collapsible-card)
        h2.dashboard__card-title Cancellation requests
        .dashboard__card-body
          if recentCancellationRequests && recentCancellationRequests.length
            ul.dashboard__list
              each request in recentCancellationRequests
                li.dashboard__list-item
                  .dashboard__item-main
                    strong Request ##{request.id} - Booking ##{request.bookingId} (Customer ##{request.userId})
                    span Reason: #{request.reason}
                    if request.adminNotes
                      span Notes: #{request.adminNotes}
                    span Submitted: #{request.createdAt}
                  .dashboard__actions
                    span.dashboard__badge= request.status
                    if String(request.status || '').toLowerCase() === 'pending'
                      form(action=`/admin/cancellations/${request.id}/review` method="POST")
                        input.dashboard__input(type="text" name="adminNotes" placeholder="Notes (optional)")
                        input(type="hidden" name="action" value="approve")
                        button.btn--primary(type="submit") Approve
                      form(action=`/admin/cancellations/${request.id}/review` method="POST")
                        input.dashboard__input(type="text" name="adminNotes" placeholder="Reason for rejection")
                        input(type="hidden" name="action" value="reject")
                        button.btn--outline(type="submit") Reject
          else
            p.dashboard__empty No cancellation requests found.

      .dashboard__card(data-collapsible-card)
        h2.dashboard__card-title Customer details (from database)
        .dashboard__card-body
          if customers && customers.length
            ul.dashboard__list
              each customer in customers
                li.dashboard__list-item
                  .dashboard__item-main
                    form(action=`/admin/customers/${customer.id}/update` method="POST")
                      .dashboard__field
                        label.dashboard__label Name
                        input.dashboard__input(type="text" name="name" value=customer.name required)
                      .dashboard__field
                        label.dashboard__label Email
                        input.dashboard__input(type="email" name="email" value=customer.email required)
                      .dashboard__actions
                        button.btn--primary(type="submit") Save customer
                    if rowFlash && rowFlash.section === 'customer' && Number(rowFlash.id) === Number(customer.id)
                      p(class=`auth__message auth__message--${rowFlash.type === 'success' ? 'success' : 'error'}`)= rowFlash.message
                    span Phone: #{customer.phone}
                    span Joined: #{customer.createdAt}
                  .dashboard__actions
                    span.dashboard__badge #{customer.bookingsCount} booking(s)
                    form(action=`/admin/customers/${customer.id}/delete` method="POST" onsubmit="return confirm('Delete this customer?')")
                      button.btn--outline(type="submit") Delete
          else
            p.dashboard__empty No customer records found.

  script.
    (function () {
      const cards = Array.from(document.querySelectorAll('[data-collapsible-card]'));
      const expandButton = document.querySelector('[data-expand-all]');
      const collapseButton = document.querySelector('[data-collapse-all]');

      function updateCardToggleButton(card, expanded) {
        const toggle = card.querySelector('[data-card-toggle]');
        if (!toggle) return;
        toggle.textContent = expanded ? 'Collapse' : 'Expand';
        toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      }

      function setCardExpanded(card, expanded) {
        const body = card.querySelector('.dashboard__card-body');
        if (!body) return;
        body.style.display = expanded ? '' : 'none';
        card.setAttribute('data-collapsed', expanded ? 'false' : 'true');
        updateCardToggleButton(card, expanded);
      }

      function setExpanded(expanded) {
        cards.forEach(function (card) {
          setCardExpanded(card, expanded);
        });
      }

      cards.forEach(function (card) {
        const title = card.querySelector('.dashboard__card-title');
        const body = card.querySelector('.dashboard__card-body');
        if (!title || !body) return;

        title.classList.add('dashboard__card-title--with-toggle');
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'dashboard__card-toggle';
        toggle.setAttribute('data-card-toggle', 'true');
        toggle.addEventListener('click', function () {
          const isCollapsed = card.getAttribute('data-collapsed') === 'true';
          setCardExpanded(card, isCollapsed);
        });
        title.appendChild(toggle);
        setCardExpanded(card, true);
      });

      if (expandButton) {
        expandButton.addEventListener('click', function () {
          setExpanded(true);
        });
      }

      if (collapseButton) {
        collapseButton.addEventListener('click', function () {
          setExpanded(false);
        });
      }
    })();
